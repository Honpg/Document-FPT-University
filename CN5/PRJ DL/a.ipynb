   "source": [
    "import datetime\n",
    "\n",
    "# Giá trị publishDate\n",
    "publish_date = 1117522800000\n",
    "\n",
    "# Chuyển đổi từ Unix timestamp (miliseconds) sang datetime\n",
    "date_time = datetime.datetime.fromtimestamp(publish_date / 1000)\n",
    "\n",
    "# In kết quả\n",
    "print(date_time.strftime('%Y-%m-%d %H:%M:%S'))\n"
   ]
  }
 ],
